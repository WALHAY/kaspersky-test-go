# Generate both values with openssl rand -hex 32 before starting Compose.
API_KEY=
POSTGRES_PASSWORD=
# API is exposed only on the local machine by default.
HTTP_PORT=8080
RATE_LIMIT_PER_MINUTE=60
MAX_BODY_BYTES=65536
REQUEST_TIMEOUT=5s
# Optional overrides for local development; these are not needed in Compose.
# DATABASE_URL=postgres://threats:password@127.0.0.1:5432/threats?sslmode=disable
# HTTP_ADDR=:8080
# TLS_CERT_FILE=/path/to/cert.pem
# TLS_KEY_FILE=/path/to/key.pem
